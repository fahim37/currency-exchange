    "@types/smtp-server": "^3.5.13",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "mailparser": "^3.9.46",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "smtp-server": "^3.20.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
