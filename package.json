    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.8",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.1",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
